    caja.textContent = 'La vista previa no pudo arrancar:\n\n' + (e && e.stack ? e.stack : String(e));
    raiz.appendChild(caja);
  }
  try {
    var preludio = [
      'var { useState, useEffect, useMemo, useCallback, useRef, useContext, useReducer,',
      '      createContext, Fragment, StrictMode } = React;',
      'var { ' + Object.keys(window.RadiaPreview.sdk).join(', ') + ' } = RadiaPreview.sdk;',
    ].join('\n');
    var fuente = Array.prototype.map
      .call(document.querySelectorAll('script[data-archivo]'), function (s) {
        return '// ---- ' + s.getAttribute('data-archivo') + '\n' + s.textContent;
      })
      .join('\n')
      .replace(/^\s*import\s[\s\S]*?\sfrom\s+['"][^'"]+['"];?/gm, '')
      .replace(/^\s*import\s+['"][^'"]+['"];?/gm, '')
      .replace(/^(\s*)export\s+default\s+/gm, '$1')
      .replace(/^(\s*)export\s+/gm, '$1')
      .replace(/import\.meta\.env\.BASE_URL/g, "'/apps/vista-previa/static/'")
      .replace(/import\.meta\.env\.[A-Z_]+/g, 'undefined');
    var codigo = Babel.transform(
      preludio + '\n' + fuente + '\n;window.__RadiaApp = typeof App !== "undefined" ? App : null;',
      { filename: 'vista-previa.tsx', presets: [['typescript', { isTSX: true, allExtensions: true }], 'react'] }
    ).code;
    new Function(codigo)();
    if (!window.__RadiaApp) throw new Error('No se encontró el componente App.');
    ReactDOM.createRoot(raiz).render(React.createElement(window.__RadiaApp));
  } catch (e) { mostrarError(e); }
})();
</script>
