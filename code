function Barras({ datos, titulo, color }: { datos: Conteo[]; titulo: string; color?: string }) {
  const max = Math.max(1, ...datos.map((d) => d.total));
  return (
    <div className="card grafico">
      <h3>{titulo}</h3>
      {datos.length === 0 && <p className="hint">Sin datos en este periodo.</p>}
      {datos.map((d) => (
        <div className="barra-fila" key={d.nombre} title={`${d.nombre}: ${d.total}`}>
          <span className="barra-etq">{d.nombre}</span>
          <span className="barra-pista">
            <span
              className="barra"
              style={{ width: `${(100 * d.total) / max}%`, background: color }}
            />
          </span>
          <span className="barra-val">{d.total}</span>
        </div>
      ))}
    </div>
  );
}

function Tendencia({ datos }: { datos: Dashboard['tendencia'] }) {
  const max = Math.max(1, ...datos.map((d) => Math.max(d.actos, d.condiciones)));
  return (
    <div className="card grafico">
      <h3>Reportes por semana (últimas 12)</h3>
      <div className="leyenda">
        <span>
          <i className="sw sw-1" /> Actos inseguros
        </span>
        <span>
          <i className="sw sw-2" /> Condiciones inseguras
        </span>
      </div>
      <div className="columnas">
        {datos.map((d) => (
          <div
            className="col-grupo"
            key={d.semana}
            title={`Semana del ${fechaCorta(d.semana)}\nActos: ${d.actos}\nCondiciones: ${d.condiciones}`}
          >
            <div className="col-barras">
              <span className="col c1" style={{ height: `${(100 * d.actos) / max}%` }} />
              <span className="col c2" style={{ height: `${(100 * d.condiciones) / max}%` }} />
            </div>
            <span className="col-etq">{fechaCorta(d.semana).slice(0, 5)}</span>
          </div>
        ))}
      </div>
    </div>
  );
}

function DashboardVista({ version }: { version: number }) {
