function Configuracion({ onCambio }: { onCambio: () => void }) {
  const [lista, setLista] = useState<Asignacion[] | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [form, setForm] = useState({ correo: '', nombre: '', rol: 'encargado', gerencia: '', area: '' });
  const [ocupado, setOcupado] = useState(false);

  const cargar = useCallback(() => {
    fetchAsignaciones()
      .then(setLista)
      .catch((e) => setError(mensaje(e)));
  }, []);
  useEffect(cargar, [cargar]);

  async function agregar(e: React.FormEvent) {
    e.preventDefault();
    setOcupado(true);
    setError(null);
    try {
      await crearAsignacion({ ...form, area: form.area === NA ? '' : form.area });
      setForm({ ...form, correo: '', nombre: '' });
      cargar();
      onCambio();
    } catch (err) {
      setError(mensaje(err));
    } finally {
      setOcupado(false);
    }
  }

  async function quitar(a: Asignacion) {
    if (!window.confirm(`¿Quitar el rol a ${a.nombre || a.correo}?`)) return;
    try {
      await borrarAsignacion(a.id);
      cargar();
      onCambio();
    } catch (err) {
      setError(mensaje(err));
    }
  }

  const seguridad = (lista ?? []).filter((a) => a.rol === 'seguridad');
  const encargados = (lista ?? []).filter((a) => a.rol === 'encargado');
  const correoValido = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(form.correo.trim());

  return (
    <section>
      <h2>Configuración de roles</h2>
      <p className="hint">
        Cualquier persona con usuario de La Unión puede reportar. Aquí se asigna quién valida
        (Seguridad Industrial) y quién da seguimiento a los reportes de cada área (encargados).
        El correo debe ser el mismo con el que la persona entra a Radia.
      </p>

      <form className="card" onSubmit={agregar}>
        <h3>Asignar rol</h3>
        <div className="fila">
          <label className="campo">
            <span>
              Correo<b className="req"> *</b>
            </span>
            <input
              type="email"
              value={form.correo}
              placeholder="nombre@launion.com.gt"
              onChange={(e) => setForm({ ...form, correo: e.target.value })}
            />
          </label>
          <label className="campo">
            <span>Nombre</span>
            <input value={form.nombre} onChange={(e) => setForm({ ...form, nombre: e.target.value })} />
          </label>
        </div>
        <label className="campo">
          <span>Rol</span>
          <select value={form.rol} onChange={(e) => setForm({ ...form, rol: e.target.value })}>
            <option value="encargado">Jefe / supervisor / encargado de área</option>
            <option value="seguridad">Seguridad Industrial (valida y administra)</option>
          </select>
        </label>
        {form.rol === 'encargado' && (
          <div className="fila">
            <SelectNivel
              etiqueta="Gerencia"
              requerido
              opciones={Object.keys(JERARQUIA)}
              valor={form.gerencia}
              onChange={(v) => setForm({ ...form, gerencia: v, area: '' })}
            />
            <label className="campo">
              <span>Área</span>
              <select
                value={form.area}
                disabled={!form.gerencia}
                onChange={(e) => setForm({ ...form, area: e.target.value })}
              >
                <option value="">Toda la gerencia</option>
                {opcionesArea(form.gerencia)
                  .filter((a) => a)
                  .map((a) => (
                    <option key={a}>{a}</option>
                  ))}
              </select>
            </label>
          </div>
        )}
        <button
          type="submit"
          className="primario"
          disabled={ocupado || !correoValido || (form.rol === 'encargado' && !form.gerencia)}
        >
          Asignar
        </button>
      </form>

      {error && <p className="aviso aviso-error">{error}</p>}

      <div className="card">
        <h3>Seguridad Industrial ({seguridad.length})</h3>
        {seguridad.map((a) => (
          <div className="asig" key={a.id}>
            <div>
              <strong>{a.nombre || a.correo}</strong>
              <div className="hint">{a.correo}</div>
            </div>
            <button type="button" className="secundario" onClick={() => quitar(a)}>
              Quitar
            </button>
          </div>
        ))}
      </div>

      <div className="card">
        <h3>Encargados de área ({encargados.length})</h3>
        {lista && encargados.length === 0 && (
          <p className="hint">
            Aún no hay encargados. Mientras un área no tenga encargado, sus reportes solo le
            llegan a Seguridad Industrial.
          </p>
        )}
        {encargados.map((a) => (
          <div className="asig" key={a.id}>
            <div>
              <strong>{a.nombre || a.correo}</strong>
              <div className="hint">
                {a.correo} · {a.gerencia}
                {a.area ? ' › ' + a.area : ' (toda la gerencia)'}
              </div>
            </div>
            <button type="button" className="secundario" onClick={() => quitar(a)}>
              Quitar
            </button>
          </div>
        ))}
      </div>
    </section>
  );
}

// ---------------------------------------------------------------------------
// Armazón
// ---------------------------------------------------------------------------

type Pestana = 'reportar' | 'mios' | 'bandeja' | 'dashboard' | 'config';

function Principal() {
  const estadoUsuario = useUserState();
  const enLinea = useEnLinea();
  const [perfil, setPerfil] = useState<Perfil>({ es_seguridad: false, encargado_de: [] });
  const [pestana, setPestana] = useState<Pestana>('reportar');
  const [pendientes, setPendientes] = useState<Pendiente[]>([]);
  const [abierto, setAbierto] = useState<number | null>(null);
  const [version, setVersion] = useState(0);

  const refrescarPendientes = useCallback(() => {
    listarPendientes().then(setPendientes, () => undefined);
  }, []);

  const sincronizarAhora = useCallback(() => {
    sincronizar()
      .then((enviados) => {
        if (enviados.length) setVersion((v) => v + 1);
      })
      .catch(() => undefined)
      .finally(refrescarPendientes);
  }, [refrescarPendientes]);

  useEffect(() => {
    fetchPerfil().then(setPerfil, () => undefined);
  }, [version]);

  useEffect(() => {
    sincronizarAhora();
    const t = window.setInterval(sincronizarAhora, 30_000);
    window.addEventListener('online', sincronizarAhora);
    return () => {
      window.clearInterval(t);
      window.removeEventListener('online', sincronizarAhora);
    };
  }, [sincronizarAhora]);

  const gestiona = perfil.es_seguridad || perfil.encargado_de.length > 0;
  const pestanas = useMemo(
    () =>
      (
        [
          ['reportar', 'Reportar'],
          ['mios', 'Mis reportes'],
          gestiona && ['bandeja', 'Bandeja'],
          gestiona && ['dashboard', 'Dashboard'],
          perfil.es_seguridad && ['config', 'Configuración'],
        ] as (false | [Pestana, string])[]
      ).filter(Boolean) as [Pestana, string][],
    [gestiona, perfil.es_seguridad],
  );

  if (estadoUsuario.kind === 'loading') return <p className="centro hint">Cargando…</p>;
  if (estadoUsuario.kind === 'error')
    return (
      <p className="centro error">
        No se pudo identificar tu usuario. Abre la app una vez con señal para iniciar sesión.
      </p>
    );
  const u = estadoUsuario.user;
  const nombre = u.display_name ?? u.name ?? u.username;
  const cambio = () => {
    setVersion((v) => v + 1);
    refrescarPendientes();
  };

  return (
    <div className="app">
      <header className="barra-sup">
        <div>
          <h1>Actos y Condiciones Inseguras</h1>
          <span className="sub">Seguridad Industrial · Ingenio La Unión</span>
        </div>
        <div className="estado-red">
          <span className={'punto ' + (enLinea ? 'en-linea' : 'sin-senal')} />
          {enLinea ? 'En línea' : 'Sin señal'}
          {pendientes.length > 0 && <span className="pend">{pendientes.length} por enviar</span>}
        </div>
      </header>

      <nav className="pestanas">
        {pestanas.map(([clave, etiqueta]) => (
          <button
            type="button"
            key={clave}
            className={pestana === clave ? 'activo' : ''}
            onClick={() => setPestana(clave)}
          >
            {etiqueta}
            {clave === 'mios' && pendientes.length > 0 && <b className="globo">{pendientes.length}</b>}
          </button>
        ))}
      </nav>

      <main className="contenido">
        {pestana === 'reportar' && (
          <FormularioReporte nombre={nombre} enLinea={enLinea} onGuardado={cambio} />
        )}
        {pestana === 'mios' && (
          <MisReportes pendientes={pendientes} version={version} onAbrir={setAbierto} onCambio={cambio} />
        )}
        {pestana === 'bandeja' && <Bandeja perfil={perfil} version={version} onAbrir={setAbierto} />}
        {pestana === 'dashboard' && <DashboardVista version={version} />}
        {pestana === 'config' && <Configuracion onCambio={cambio} />}
      </main>

      {abierto !== null && (
        <Detalle id={abierto} onCerrar={() => setAbierto(null)} onCambio={() => setVersion((v) => v + 1)} />
      )}
    </div>
  );
}

export function App() {
  return (
    <AppStoreProvider loadUser={fetchMe}>
      <Principal />
    </AppStoreProvider>
  );
}

