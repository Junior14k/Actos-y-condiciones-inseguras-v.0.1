function Dato({ k, v }: { k: string; v: string | null | undefined }) {
  if (!v) return null;
  return (
    <div className="dato">
      <dt>{k}</dt>
      <dd>{v}</dd>
    </div>
  );
}

function Detalle({
  id,
  onCerrar,
  onCambio,
}: {
  id: number;
  onCerrar: () => void;
  onCambio: () => void;
}) {
  const [r, setR] = useState<Reporte | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [ocupado, setOcupado] = useState(false);
  const [comentario, setComentario] = useState('');
  const [plan, setPlan] = useState({ accion: '', responsable: '', fecha_compromiso: '' });
  const [cierre, setCierre] = useState('');
  const [fotoCierre, setFotoCierre] = useState<string | null>(null);

  useEffect(() => {
    fetchReporte(id)
      .then((x) => {
        setR(x);
        setPlan({
          accion: x.plan_accion,
          responsable: x.plan_responsable,
          fecha_compromiso: x.plan_fecha ?? '',
        });
      })
      .catch((e) => setError(mensaje(e)));
  }, [id]);

  async function accion(fn: () => Promise<Reporte>) {
    setOcupado(true);
    setError(null);
    try {
      setR(await fn());
      onCambio();
    } catch (e) {
      setError(mensaje(e));
    } finally {
      setOcupado(false);
    }
  }

  return (
    <div className="modal" role="dialog" aria-modal="true" onClick={onCerrar}>
      <div className="modal-caja" onClick={(e) => e.stopPropagation()}>
        <div className="modal-cab">
          <h2>{r ? `Reporte #${r.id}` : 'Reporte'}</h2>
          <button type="button" className="cerrar" onClick={onCerrar} aria-label="Cerrar">
            ✕
          </button>
        </div>
        {!r && !error && <p className="hint">Cargando…</p>}
        {error && <p className="aviso aviso-error">{error}</p>}
        {r && (
          <>
            <div className="chips-fila">
              <Estado r={r} />
              <Severidad valor={r.severidad} />
              <span className="chip">{r.tipo}</span>
            </div>
            <p className="descripcion">{r.descripcion}</p>
            <dl className="datos">
              <Dato k="Fecha y hora" v={`${fechaCorta(r.fecha)} ${r.hora}`} />
              <Dato k="Gerencia" v={r.gerencia} />
              <Dato k="Área" v={r.area} />
              <Dato k="Proceso" v={r.proceso} />
              <Dato k="Sub proceso" v={r.subproceso} />
              <Dato k="Lugar" v={r.lugar} />
              <Dato k="Riesgo" v={`${r.tipo_riesgo} — ${r.riesgo}`} />
              <Dato k="Máquina" v={r.codigo_maquina} />
              <Dato k="Reportó" v={r.reporta_nombre} />
            </dl>
            {r.fotos.includes('reporte') && (
              <img className="foto-detalle" src={fotoUrl(r.id, 'reporte')} alt="Foto del reporte" />
            )}

            {r.estado === 'Rechazado' && (
              <div className="bloque">
                <h3>No procede</h3>
                <p>{r.validacion_comentario}</p>
                <p className="hint">— {r.validado_por}</p>
              </div>
            )}
            {r.plan_accion && (
              <div className="bloque">
                <h3>Plan de acción</h3>
                <p>{r.plan_accion}</p>
                <p className="hint">
                  Responsable: {r.plan_responsable} · Compromiso:{' '}
                  {r.plan_fecha ? fechaCorta(r.plan_fecha) : '—'}
                </p>
              </div>
            )}
            {r.estado === 'Cerrado' && (
              <div className="bloque bloque-ok">
                <h3>Cierre</h3>
                <p>{r.cierre_comentario}</p>
                <p className="hint">
                  — {r.cerrado_por}
                  {r.cerrado_at && `, ${fechaHora(r.cerrado_at)}`}
                </p>
                {r.fotos.includes('cierre') && (
                  <img className="foto-detalle" src={fotoUrl(r.id, 'cierre')} alt="Evidencia de cierre" />
                )}
              </div>
            )}

            {r.puede_validar && (
              <div className="bloque bloque-accion">
                <h3>Validación de Seguridad Industrial</h3>
                <textarea
                  rows={2}
                  placeholder="Comentario (obligatorio si no procede)"
                  value={comentario}
                  onChange={(e) => setComentario(e.target.value)}
                />
                <div className="botones">
                  <button
                    type="button"
                    className="primario"
                    disabled={ocupado}
                    onClick={() => accion(() => validarReporte(r.id, true, comentario))}
                  >
                    Validar
                  </button>
                  <button
                    type="button"
                    className="peligro"
                    disabled={ocupado || !comentario.trim()}
                    onClick={() => accion(() => validarReporte(r.id, false, comentario))}
                  >
                    No procede
                  </button>
                </div>
              </div>
            )}

            {r.puede_gestionar && (
              <div className="bloque bloque-accion">
                <h3>{r.estado === 'Validado' ? 'Registrar plan de acción' : 'Actualizar plan de acción'}</h3>
                <textarea
                  rows={3}
                  placeholder="¿Qué se va a hacer para eliminar el riesgo?"
                  value={plan.accion}
                  onChange={(e) => setPlan({ ...plan, accion: e.target.value })}
                />
                <div className="fila">
                  <label className="campo">
                    <span>Responsable</span>
                    <input
                      value={plan.responsable}
                      onChange={(e) => setPlan({ ...plan, responsable: e.target.value })}
                    />
                  </label>
                  <label className="campo">
                    <span>Fecha compromiso</span>
                    <input
                      type="date"
                      value={plan.fecha_compromiso}
                      onChange={(e) => setPlan({ ...plan, fecha_compromiso: e.target.value })}
                    />
                  </label>
                </div>
                <button
                  type="button"
                  className="primario"
                  disabled={
                    ocupado || !plan.accion.trim() || !plan.responsable.trim() || !plan.fecha_compromiso
                  }
                  onClick={() => accion(() => registrarPlan(r.id, plan))}
                >
                  Guardar plan
                </button>
              </div>
            )}

            {r.puede_gestionar && r.estado === 'En plan de acción' && (
              <div className="bloque bloque-accion">
                <h3>Cerrar reporte</h3>
                <textarea
                  rows={2}
                  placeholder="¿Qué se hizo? Evidencia del cierre"
                  value={cierre}
                  onChange={(e) => setCierre(e.target.value)}
                />
                {fotoCierre ? (
                  <div className="foto-previa">
                    <img src={fotoCierre} alt="Evidencia" />
                    <button type="button" className="secundario" onClick={() => setFotoCierre(null)}>
                      Quitar foto
                    </button>
                  </div>
                ) : (
                  <label className="boton-foto">
                    📷 Foto de evidencia (opcional)
                    <input
                      type="file"
                      accept="image/*"
                      capture="environment"
                      hidden
                      onChange={(e) => {
                        const a = e.target.files?.[0];
                        e.target.value = '';
                        if (a) comprimirFoto(a).then(setFotoCierre, (x) => setError(mensaje(x)));
                      }}
                    />
                  </label>
                )}
                <button
                  type="button"
                  className="exito"
                  disabled={ocupado || !cierre.trim()}
                  onClick={() => accion(() => cerrarReporte(r.id, cierre, fotoCierre))}
                >
                  Cerrar reporte
                </button>
              </div>
            )}

            {r.eventos.length > 0 && (
              <div className="bloque">
                <h3>Historial</h3>
                <ol className="historial">
                  {r.eventos.map((e, i) => (
                    <li key={i}>
                      <strong>{e.accion}</strong> · {e.usuario_nombre}
                      <span className="hint"> · {fechaHora(e.created_at)}</span>
                      {e.detalle && <div>{e.detalle}</div>}
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </>
        )}
      </div>
    </div>
  );
}

