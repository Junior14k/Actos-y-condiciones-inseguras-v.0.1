    e.status = status;
    Object.setPrototypeOf(e, ApiError.prototype);
    return e;
  }
  ApiError.prototype = Object.create(Error.prototype);

  var Contexto = React.createContext({ kind: 'loading' });

  function AppStoreProvider(props) {
    var estado = React.useState({ kind: 'loading' });
    React.useEffect(function () {
      props.loadUser().then(
        function (u) { estado[1]({ kind: 'ok', user: u }); },
        function (e) { estado[1]({ kind: 'error', message: String(e && e.message) }); }
      );
    }, []);
    return h(Contexto.Provider, { value: estado[0] }, props.children);
  }
  function useUserState() { return React.useContext(Contexto); }
  function useUser() { var s = useUserState(); return s.kind === 'ok' ? s.user : null; }
  function userHasPermission(u, code) {
    return !!u && (u.permissions.indexOf('*') !== -1 || u.permissions.indexOf(code) !== -1);
  }
  function usePermission(code) { return userHasPermission(useUser(), code); }
  function useLogout() { return function () { window.alert('Vista previa: acá se cerraría la sesión.'); }; }
  function RequirePermission(props) {
    var s = useUserState();
    if (s.kind === 'loading') return props.loading || null;
    return usePermission(props.code) ? props.children : props.fallback || null;
  }

  window.RadiaPreview = {
    usuario: usuario,
    sdk: {
      AppStoreProvider: AppStoreProvider,
      useUser: useUser,
      useUserState: useUserState,
      usePermission: usePermission,
      useLogout: useLogout,
      RequirePermission: RequirePermission,
      userHasPermission: userHasPermission,
      createClient: null,
      ApiError: ApiError,
    },
