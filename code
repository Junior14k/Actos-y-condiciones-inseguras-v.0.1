<style>
:root {
  color-scheme: light;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --fondo: #f4f5f3;
  --superficie: #ffffff;
  --borde: #e2e4df;
  --texto: #1b1d1a;
  --texto-2: #5b5f58;
  --marca: #1f6b3a;
  --marca-osc: #17532d;
  --marca-suave: #e5f1e8;
  --peligro: #b42318;
  --alerta: #b54708;
  --serie-1: #2a78d6;
  --serie-2: #eb6834;
  --radio: 10px;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--fondo);
  color: var(--texto);
  font-size: 15px;
  line-height: 1.45;
}

h1, h2, h3 { margin: 0 0 0.6rem; line-height: 1.2; }
h2 { font-size: 1.2rem; }
h3 { font-size: 1rem; }

.app { min-height: 100vh; }

.barra-sup {
  display: flex; justify-content: space-between; align-items: center; gap: 12px;
  background: var(--marca); color: #fff; padding: 12px 16px;
}
.barra-sup h1 { font-size: 1.05rem; margin: 0; }
.barra-sup .sub { font-size: 0.8rem; opacity: 0.85; }
.estado-red { display: flex; align-items: center; gap: 6px; font-size: 0.8rem; white-space: nowrap; flex-wrap: wrap; justify-content: flex-end; }
.punto { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
.en-linea { background: #6fe39a; }
.sin-senal { background: #ffb020; }
.pend { background: #ffb020; color: #3d2a00; border-radius: 999px; padding: 1px 8px; font-weight: 600; }

.pestanas {
  display: flex; gap: 2px; overflow-x: auto; background: var(--superficie);
  border-bottom: 1px solid var(--borde); padding: 0 8px; position: sticky; top: 0; z-index: 5;
}
.pestanas button {
  background: none; border: 0; border-bottom: 3px solid transparent; padding: 12px 12px;
  font: inherit; color: var(--texto-2); cursor: pointer; white-space: nowrap;
}
.pestanas button.activo { color: var(--marca); border-bottom-color: var(--marca); font-weight: 600; }
.globo { background: var(--alerta); color: #fff; border-radius: 999px; padding: 0 6px; margin-left: 6px; font-size: 0.75rem; }

.contenido { max-width: 860px; margin: 0 auto; padding: 16px; }
.centro { text-align: center; padding: 3rem 1rem; }

.card {
  background: var(--superficie); border: 1px solid var(--borde); border-radius: var(--radio);
  padding: 16px; margin-bottom: 16px;
}

.campo { display: flex; flex-direction: column; gap: 4px; margin: 0 0 14px; border: 0; padding: 0; min-width: 0; flex: 1; }
.campo > span { font-size: 0.85rem; font-weight: 600; color: var(--texto-2); }
.req { color: var(--peligro); }
.fila { display: flex; gap: 12px; flex-wrap: wrap; }
.fila > .campo { min-width: 180px; }

input, select, textarea {
  font: inherit; color: inherit; background: #fff; width: 100%;
  border: 1px solid #c9ccc5; border-radius: 8px; padding: 10px 10px; min-height: 44px;
}
textarea { resize: vertical; }
input:focus, select:focus, textarea:focus { outline: 2px solid var(--marca); outline-offset: 1px; border-color: var(--marca); }
input:disabled, select:disabled { background: #f0f1ee; color: var(--texto-2); }

button { font: inherit; cursor: pointer; }
button:disabled { opacity: 0.55; cursor: not-allowed; }
.primario, .secundario, .peligro, .exito {
  border-radius: 8px; padding: 10px 16px; min-height: 44px; border: 1px solid transparent; font-weight: 600;
}
.primario { background: var(--marca); color: #fff; }
.primario:hover:not(:disabled) { background: var(--marca-osc); }
.secundario { background: #fff; color: var(--texto); border-color: #c9ccc5; }
.peligro { background: #fff; color: var(--peligro); border-color: var(--peligro); }
.exito { background: var(--marca); color: #fff; }
.grande { width: 100%; font-size: 1.05rem; padding: 14px; }
.enlace { background: none; border: 0; color: var(--marca); text-decoration: underline; padding: 0; }
.botones { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }

.segmentado { display: flex; gap: 8px; flex-wrap: wrap; }
.segmentado button {
