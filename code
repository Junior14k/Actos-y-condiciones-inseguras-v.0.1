.aviso { border-radius: 8px; padding: 10px 12px; margin: 4px 0 14px; }
.aviso-ok { background: var(--marca-suave); color: var(--marca-osc); }
.aviso-pendiente { background: #fff4e0; color: #6b3d00; }
.aviso-error { background: #fdecea; color: var(--peligro); }
.error { color: var(--peligro); }
.hint { color: var(--texto-2); font-size: 0.85rem; }
.vacio { color: var(--texto-2); text-align: center; padding: 24px 8px; }

