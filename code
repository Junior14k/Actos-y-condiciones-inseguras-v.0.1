.tarjeta-cab { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
.tarjeta-desc { margin: 6px 0; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.tarjeta-pie { display: flex; gap: 10px; flex-wrap: wrap; font-size: 0.8rem; color: var(--texto-2); align-items: center; }

.pendiente { display: flex; justify-content: space-between; gap: 10px; padding: 10px 0; border-top: 1px solid var(--borde); }

.filtros { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 6px; margin-bottom: 10px; }
.filtro { border: 1px solid #c9ccc5; background: #fff; border-radius: 999px; padding: 6px 12px; white-space: nowrap; }
.filtro.activo { background: var(--marca); border-color: var(--marca); color: #fff; }
.buscador { margin-bottom: 12px; }

.modal {
  position: fixed; inset: 0; background: rgba(20, 22, 19, 0.5); z-index: 20;
  display: flex; justify-content: center; align-items: flex-start; overflow-y: auto; padding: 24px 12px;
}
.modal-caja { background: var(--superficie); border-radius: 12px; width: 100%; max-width: 680px; padding: 18px; }
.modal-cab { display: flex; justify-content: space-between; align-items: center; }
.cerrar { background: none; border: 0; font-size: 1.3rem; padding: 6px 10px; }
.descripcion { white-space: pre-wrap; font-size: 1.02rem; }
.datos { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px 16px; margin: 0 0 8px; }
.dato dt { font-size: 0.75rem; color: var(--texto-2); font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em; }
.dato dd { margin: 0; }
.bloque { border-top: 1px solid var(--borde); padding-top: 12px; margin-top: 12px; }
.bloque p { margin: 0 0 4px; white-space: pre-wrap; }
.bloque-accion { background: #fafbf9; border: 1px solid var(--borde); border-radius: var(--radio); padding: 12px; }
.bloque-accion textarea { margin-bottom: 10px; }
.bloque-ok h3 { color: var(--marca-osc); }
.historial { margin: 0; padding-left: 18px; }
.historial li { margin-bottom: 8px; }

.asig { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 0; border-top: 1px solid var(--borde); }

/* Dashboard */
.dash-cab { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.filtros-dash { display: flex; gap: 12px; flex-wrap: wrap; }
.filtros-dash .campo { min-width: 150px; }
.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 16px; }
.kpi { background: var(--superficie); border: 1px solid var(--borde); border-radius: var(--radio); padding: 12px; display: flex; flex-direction: column; }
.kpi span { font-size: 0.8rem; color: var(--texto-2); }
.kpi b { font-size: 1.8rem; font-variant-numeric: tabular-nums; }
.kpi small { color: var(--texto-2); }
.kpi-alerta { border-color: var(--peligro); }
.kpi-alerta span { color: var(--peligro); font-weight: 600; }
.graficos { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 0 16px; }
.barra-fila { display: grid; grid-template-columns: minmax(90px, 40%) 1fr 34px; align-items: center; gap: 8px; margin: 6px 0; font-size: 0.85rem; }
.barra-etq { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.barra-pista { height: 14px; }
.barra { display: block; height: 100%; background: var(--serie-1); border-radius: 0 4px 4px 0; min-width: 2px; }
.barra-val { text-align: right; font-variant-numeric: tabular-nums; color: var(--texto-2); }
.leyenda { display: flex; gap: 16px; font-size: 0.82rem; color: var(--texto-2); margin-bottom: 8px; flex-wrap: wrap; }
.sw { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 4px; vertical-align: -1px; }
.sw-1, .c1 { background: var(--serie-1); }
.sw-2, .c2 { background: var(--serie-2); }
.columnas { display: flex; gap: 4px; align-items: stretch; height: 160px; border-bottom: 1px solid var(--borde); }
.col-grupo { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.col-grupo:hover { background: #f4f5f3; }
.col-barras { flex: 1; display: flex; align-items: flex-end; justify-content: center; gap: 2px; }
.col { width: 40%; max-width: 14px; border-radius: 4px 4px 0 0; min-height: 0; }
.col-etq { font-size: 0.68rem; color: var(--texto-2); text-align: center; padding-top: 4px; margin-bottom: -20px; }
.grafico .columnas { margin-bottom: 22px; }
.tabla { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
.tabla th, .tabla td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--borde); }
.tabla td:not(:first-child), .tabla th:not(:first-child) { text-align: right; font-variant-numeric: tabular-nums; }

@media (max-width: 520px) {
  .contenido { padding: 12px; }
  .barra-sup h1 { font-size: 0.95rem; }
  .modal { padding: 0; }
  .modal-caja { border-radius: 0; min-height: 100vh; }
  .col-etq { font-size: 0.6rem; }
}

.pestanas { top: 35px; }
.modal { z-index: 10000; }
</style>
