.segmentado button.activo { background: var(--marca); border-color: var(--marca); color: #fff; font-weight: 600; }
.segmentado .sevbtn-alto.activo { background: var(--peligro); border-color: var(--peligro); }
.segmentado .sevbtn-medio.activo { background: var(--alerta); border-color: var(--alerta); }

.boton-foto {
