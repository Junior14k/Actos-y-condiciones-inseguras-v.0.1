.e-reportado { background: #e3edfb; color: #1d4f91; }
.e-validado { background: #efe7fb; color: #4b2a8f; }
.e-rechazado { background: #eceee9; color: var(--texto-2); }
.e-plan { background: #fff1d6; color: #7a4a00; }
.e-cerrado { background: var(--marca-suave); color: var(--marca-osc); }
.e-vencido { background: #fdecea; color: var(--peligro); }
.sev { border-radius: 4px; padding: 1px 8px; font-size: 0.78rem; font-weight: 700; border: 1px solid; }
.sev-alto { color: var(--peligro); border-color: var(--peligro); }
.sev-medio { color: var(--alerta); border-color: var(--alerta); }
