              <option key={g}>{g}</option>
            ))}
          </select>
        </label>
      </div>
      {error && <p className="error">No se pudo cargar: {error}</p>}
      {d && (
        <>
          <div className="kpis">
            <div className="kpi">
              <span>Reportes</span>
              <b>{d.total}</b>
            </div>
            <div className="kpi">
              <span>Abiertos</span>
              <b>{d.abiertos}</b>
            </div>
            <div className="kpi">
              <span>Cerrados</span>
              <b>{d.cerrados}</b>
              <small>{d.porcentaje_cierre}% de los válidos</small>
            </div>
            <div className={'kpi ' + (d.vencidos ? 'kpi-alerta' : '')}>
              <span>{d.vencidos ? '⚠ ' : ''}Planes vencidos</span>
              <b>{d.vencidos}</b>
            </div>
            <div className="kpi">
              <span>Días promedio al cierre</span>
              <b>{d.dias_promedio_cierre ?? '—'}</b>
            </div>
          </div>
          <Tendencia datos={d.tendencia} />
          <div className="graficos">
            <Barras titulo="Por estado" datos={d.por_estado} />
            <Barras titulo="Actos vs. condiciones" datos={d.por_tipo} />
            <Barras titulo="Potencial de severidad" datos={d.por_severidad} />
            <Barras titulo="Por tipo de riesgo" datos={d.por_riesgo} />
          </div>
          <div className="card grafico">
            <h3>Por gerencia</h3>
            {d.por_gerencia.length === 0 ? (
              <p className="hint">Sin datos en este periodo.</p>
