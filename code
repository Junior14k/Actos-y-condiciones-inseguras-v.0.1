          <span>Hasta</span>
          <input
            type="date"
            value={filtros.hasta}
            onChange={(e) => setFiltros({ ...filtros, hasta: e.target.value })}
          />
        </label>
        <label className="campo">
          <span>Gerencia</span>
          <select
            value={filtros.gerencia}
            onChange={(e) => setFiltros({ ...filtros, gerencia: e.target.value })}
          >
            <option value="">Todas</option>
