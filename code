<script type="text/plain" data-archivo="api.ts">
// Cliente HTTP al backend de la app. El transporte (fetch + cookies MIAM +
// errores) vive en @launion/miam-appstore-sdk.

import { createClient } from '@launion/miam-appstore-sdk';
import type { User } from '@launion/miam-appstore-sdk';

// `BASE_URL` es `/apps/<slug>/static/` (sale del manifest); la API vive al lado.
const API_BASE = import.meta.env.BASE_URL.replace(/\/static\/?$/, '/api');
const api = createClient(API_BASE);

// --- Caché local mínima, para que la app abra sin señal --------------------
// Solo datos del propio usuario (quién es, su rol, sus reportes). Si el
// navegador no deja guardar, la app sigue funcionando en línea.

function leerCache<T>(clave: string): T | null {
  try {
    const crudo = window.localStorage.getItem('actos-inseguros:' + clave);
    return crudo ? (JSON.parse(crudo) as T) : null;
  } catch {
    return null;
  }
}

function escribirCache(clave: string, valor: unknown): void {
  try {
    window.localStorage.setItem('actos-inseguros:' + clave, JSON.stringify(valor));
  } catch {
    // Sin almacenamiento: no pasa nada, solo no habrá modo sin señal.
  }
}

/** ¿El error es de red (sin señal) y no una respuesta del servidor? */
export function esErrorDeRed(err: unknown): boolean {
  const status = (err as { status?: number } | null)?.status;
  return typeof status !== 'number' || status === 0;
}

async function conCache<T>(clave: string, pedir: () => Promise<T>): Promise<T> {
  try {
    const valor = await pedir();
    escribirCache(clave, valor);
    return valor;
  } catch (err) {
    const guardado = leerCache<T>(clave);
    if (esErrorDeRed(err) && guardado !== null) return guardado;
    throw err;
  }
}

/** Usuario para `<AppStoreProvider>`. Sin señal, el último que entró. */
export function fetchMe(): Promise<User> {
  return conCache('me', () => api.get<User>('/me'));
}

// --- Tipos ------------------------------------------------------------------

export type Perfil = {
  es_seguridad: boolean;
  encargado_de: { gerencia: string; area: string }[];
};

export type ReporteNuevo = {
  client_id: string;
  tipo: string;
  fecha: string;
  hora: string;
  gerencia: string;
  area: string;
  proceso: string;
  subproceso: string;
  lugar: string;
  tipo_riesgo: string;
  riesgo: string;
  descripcion: string;
  severidad: string;
  codigo_maquina: string;
  foto: string | null;
};

export type Evento = {
  accion: string;
  detalle: string;
  usuario_nombre: string;
  created_at: string;
};

export type Reporte = Omit<ReporteNuevo, 'foto'> & {
  id: number;
  reporta_nombre: string;
  reporta_correo: string;
  es_mio: boolean;
  estado: string;
  validacion_comentario: string;
  validado_por: string;
  validado_at: string | null;
  plan_accion: string;
  plan_responsable: string;
  plan_fecha: string | null;
  plan_por: string;
  plan_at: string | null;
  cierre_comentario: string;
  cerrado_por: string;
  cerrado_at: string | null;
  vencido: boolean;
  created_at: string;
  fotos: string[];
  eventos: Evento[];
  puede_validar: boolean;
  puede_gestionar: boolean;
};

export type Conteo = { nombre: string; total: number };

export type Dashboard = {
  total: number;
  abiertos: number;
  cerrados: number;
  vencidos: number;
  porcentaje_cierre: number;
  dias_promedio_cierre: number | null;
  por_estado: Conteo[];
  por_tipo: Conteo[];
  por_severidad: Conteo[];
  por_gerencia: (Conteo & { abiertos: number })[];
  por_riesgo: Conteo[];
  tendencia: { semana: string; actos: number; condiciones: number }[];
};

export type Asignacion = {
  id: number;
  correo: string;
  nombre: string;
  rol: 'seguridad' | 'encargado';
  gerencia: string;
  area: string;
  creado_por: string;
  created_at: string;
};

// --- Llamadas ---------------------------------------------------------------

export function fetchPerfil(): Promise<Perfil> {
  return conCache('perfil', () => api.get<Perfil>('/perfil'));
}

export function enviarReporte(r: ReporteNuevo): Promise<Reporte> {
  return api.post<Reporte>('/reportes', r);
}

export function fetchMisReportes(): Promise<Reporte[]> {
  return conCache('mis-reportes', () => api.get<Reporte[]>('/reportes?vista=mios'));
}

export function fetchBandeja(): Promise<Reporte[]> {
  return api.get<Reporte[]>('/reportes?vista=bandeja');
}

export function fetchReporte(id: number): Promise<Reporte> {
  return api.get<Reporte>(`/reportes/${id}`);
}

export function fotoUrl(id: number, tipo: string): string {
  // La vista previa (sin servidor) inyecta sus fotos por este gancho.
  const previa = (window as unknown as { RadiaFotoUrl?: (id: number, tipo: string) => string })
    .RadiaFotoUrl;
  return previa ? previa(id, tipo) : `${API_BASE}/reportes/${id}/fotos/${tipo}`;
}

export function validarReporte(id: number, aprobado: boolean, comentario: string) {
  return api.post<Reporte>(`/reportes/${id}/validacion`, { aprobado, comentario });
}

export function registrarPlan(
  id: number,
  plan: { accion: string; responsable: string; fecha_compromiso: string },
) {
  return api.post<Reporte>(`/reportes/${id}/plan`, plan);
}

export function cerrarReporte(id: number, comentario: string, foto: string | null) {
  return api.post<Reporte>(`/reportes/${id}/cierre`, { comentario, foto });
}

export function fetchDashboard(filtros: {
  desde?: string;
  hasta?: string;
  gerencia?: string;
}): Promise<Dashboard> {
  const q = new URLSearchParams();
  Object.entries(filtros).forEach(([k, v]) => {
    if (v) q.set(k, v);
  });
  const qs = q.toString();
  return api.get<Dashboard>('/dashboard' + (qs ? '?' + qs : ''));
}

export function fetchAsignaciones(): Promise<Asignacion[]> {
  return api.get<Asignacion[]>('/asignaciones');
}

export function crearAsignacion(a: {
  correo: string;
  nombre: string;
  rol: string;
  gerencia: string;
  area: string;
}): Promise<Asignacion> {
  return api.post<Asignacion>('/asignaciones', a);
}

export function borrarAsignacion(id: number): Promise<null> {
  return api.del<null>(`/asignaciones/${id}`);
}

</script>
<script type="text/plain" data-archivo="offline.ts">
// Bandeja de salida para reportar sin señal.
//
// Todo reporte se guarda primero aquí (IndexedDB del teléfono) y después se
// intenta enviar. Si no hay señal queda pendiente y se reenvía solo al volver
// la conexión. El `client_id` hace que un reenvío nunca cree un duplicado.

import { enviarReporte, esErrorDeRed, type Reporte, type ReporteNuevo } from './api';

export type Pendiente = {
  client_id: string;
  body: ReporteNuevo;
  guardado: string;
  /** Rechazo del servidor que reintentar no arregla (dato inválido). */
  error?: string;
};

const DB_NOMBRE = 'actos-inseguros';
const STORE = 'pendientes';
let memoria: Pendiente[] = []; // respaldo si el navegador no tiene IndexedDB

function abrir(): Promise<IDBDatabase | null> {
  return new Promise((ok) => {
    try {
      if (!('indexedDB' in window)) return ok(null);
      const req = window.indexedDB.open(DB_NOMBRE, 1);
      req.onupgradeneeded = () => {
        req.result.createObjectStore(STORE, { keyPath: 'client_id' });
      };
      req.onsuccess = () => ok(req.result);
      req.onerror = () => ok(null);
    } catch {
      ok(null);
    }
  });
}

async function conStore<T>(
  modo: IDBTransactionMode,
  fn: (s: IDBObjectStore) => IDBRequest<T>,
  respaldo: () => T,
): Promise<T> {
  const db = await abrir();
  if (!db) return respaldo();
  return new Promise((ok, falla) => {
    const req = fn(db.transaction(STORE, modo).objectStore(STORE));
    req.onsuccess = () => ok(req.result);
    req.onerror = () => falla(req.error);
  });
}

export async function listarPendientes(): Promise<Pendiente[]> {
  const todos = await conStore<Pendiente[]>(
    'readonly',
    (s) => s.getAll() as IDBRequest<Pendiente[]>,
    () => memoria.slice(),
  );
  return todos.sort((a, b) => a.guardado.localeCompare(b.guardado));
}

export async function guardarPendiente(p: Pendiente): Promise<void> {
  await conStore<IDBValidKey>(
    'readwrite',
    (s) => s.put(p),
    () => {
      memoria = [...memoria.filter((x) => x.client_id !== p.client_id), p];
      return p.client_id;
    },
  );
}

export async function descartarPendiente(clientId: string): Promise<void> {
  await conStore<undefined>(
    'readwrite',
    (s) => s.delete(clientId) as IDBRequest<undefined>,
    () => {
      memoria = memoria.filter((x) => x.client_id !== clientId);
      return undefined;
    },
  );
}

export function nuevoClientId(): string {
  const c = (window as { crypto?: Crypto }).crypto;
  if (c && typeof c.randomUUID === 'function') return c.randomUUID();
  return 'r-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
}

let enCurso: Promise<Reporte[]> | null = null;

/** Envía lo pendiente. Devuelve los reportes que llegaron al servidor. */
export function sincronizar(): Promise<Reporte[]> {
  if (enCurso) return enCurso;
  enCurso = (async () => {
    const enviados: Reporte[] = [];
    for (const p of await listarPendientes()) {
      if (p.error) continue;
      try {
        enviados.push(await enviarReporte(p.body));
        await descartarPendiente(p.client_id);
      } catch (err) {
        const status = (err as { status?: number }).status;
        // Sin señal, sesión vencida o servidor caído: se reintenta después.
        if (esErrorDeRed(err) || status === 401 || status === 429 || (status ?? 0) >= 500) {
          break;
        }
        await guardarPendiente({ ...p, error: (err as Error).message });
      }
    }
    return enviados;
  })().finally(() => {
    enCurso = null;
  });
  return enCurso;
}

</script>
<script type="text/plain" data-archivo="App.tsx">
// Reporte de Actos y Condiciones Inseguras — Ingenio La Unión.
// Pantallas: Reportar (funciona sin señal), Mis reportes, Bandeja, Dashboard
// y Configuración (roles). Quién ve qué lo decide el backend con /perfil.

import { useCallback, useEffect, useMemo, useState } from 'react';
import { AppStoreProvider, useUserState } from '@launion/miam-appstore-sdk';
import {
  borrarAsignacion,
  cerrarReporte,
  crearAsignacion,
  fetchAsignaciones,
  fetchBandeja,
  fetchDashboard,
  fetchMe,
  fetchMisReportes,
  fetchPerfil,
  fetchReporte,
  fotoUrl,
  registrarPlan,
  validarReporte,
  type Asignacion,
  type Conteo,
  type Dashboard,
  type Perfil,
  type Reporte,
  type ReporteNuevo,
} from './api';
import { JERARQUIA, RIESGOS, SEVERIDADES, TIPOS_REPORTE } from './catalogo';
import {
  descartarPendiente,
  guardarPendiente,
  listarPendientes,
  nuevoClientId,
  sincronizar,
  type Pendiente,
} from './offline';

// ---------------------------------------------------------------------------
// Utilidades
// ---------------------------------------------------------------------------

const NA = '__no_aplica__';

function dosDigitos(n: number): string {
  return String(n).padStart(2, '0');
}
function hoyLocal(): string {
  const d = new Date();
  return `${d.getFullYear()}-${dosDigitos(d.getMonth() + 1)}-${dosDigitos(d.getDate())}`;
}
function horaLocal(): string {
  const d = new Date();
  return `${dosDigitos(d.getHours())}:${dosDigitos(d.getMinutes())}`;
}
function fechaCorta(iso: string): string {
  const [a, m, d] = iso.slice(0, 10).split('-');
  return `${d}/${m}/${a}`;
}
function fechaHora(iso: string): string {
  return new Date(iso).toLocaleString('es-GT', { dateStyle: 'short', timeStyle: 'short' });
}
function mensaje(err: unknown): string {
  return (err as Error)?.message || 'Ocurrió un error.';
}

/** Reduce la foto en el teléfono (máx. 1280 px, JPG) para que viaje liviana. */
function comprimirFoto(archivo: File): Promise<string> {
  return new Promise((ok, falla) => {
    const lector = new FileReader();
    lector.onerror = () => falla(new Error('No se pudo leer la foto.'));
    lector.onload = () => {
      const img = new Image();
      img.onerror = () => falla(new Error('El archivo no es una imagen válida.'));
      img.onload = () => {
        const escala = Math.min(1, 1280 / Math.max(img.width, img.height));
        const lienzo = document.createElement('canvas');
        lienzo.width = Math.round(img.width * escala);
        lienzo.height = Math.round(img.height * escala);
        const ctx = lienzo.getContext('2d');
        if (!ctx) return ok(String(lector.result));
        ctx.drawImage(img, 0, 0, lienzo.width, lienzo.height);
        ok(lienzo.toDataURL('image/jpeg', 0.72));
      };
      img.src = String(lector.result);
    };
    lector.readAsDataURL(archivo);
  });
}

function useEnLinea(): boolean {
  const [enLinea, setEnLinea] = useState(navigator.onLine);
  useEffect(() => {
    const si = () => setEnLinea(true);
    const no = () => setEnLinea(false);
    window.addEventListener('online', si);
    window.addEventListener('offline', no);
    return () => {
      window.removeEventListener('online', si);
      window.removeEventListener('offline', no);
    };
  }, []);
  return enLinea;
}

const CLASE_ESTADO: Record<string, string> = {
  Reportado: 'e-reportado',
  Validado: 'e-validado',
  Rechazado: 'e-rechazado',
  'En plan de acción': 'e-plan',
  Cerrado: 'e-cerrado',
};

function Estado({ r }: { r: Pick<Reporte, 'estado' | 'vencido'> }) {
  return (
    <span className="chips">
      <span className={'chip ' + (CLASE_ESTADO[r.estado] ?? '')}>{r.estado}</span>
      {r.vencido && <span className="chip e-vencido">⚠ Vencido</span>}
    </span>
  );
}

function Severidad({ valor }: { valor: string }) {
  return <span className={'sev sev-' + valor.toLowerCase()}>{valor}</span>;
}

// ---------------------------------------------------------------------------
// Selects en cascada (Gerencia → Área → Proceso → Sub proceso)
// ---------------------------------------------------------------------------

function SelectNivel(props: {
  etiqueta: string;
  opciones: string[];
  valor: string;
  onChange: (v: string) => void;
  requerido?: boolean;
  deshabilitado?: boolean;
}) {
  const reales = props.opciones.filter((o) => o !== '');
  const permiteNA = props.opciones.includes('') || !props.requerido;
  return (
    <label className="campo">
      <span>
        {props.etiqueta}
        {props.requerido && <b className="req"> *</b>}
      </span>
      <select
        value={props.valor}
        disabled={props.deshabilitado}
        onChange={(e) => props.onChange(e.target.value)}
      >
        {props.requerido ? (
          <option value="">Selecciona…</option>
        ) : (
          <option value="">— No aplica —</option>
        )}
        {props.requerido && permiteNA && <option value={NA}>No aplica</option>}
        {reales.map((o) => (
          <option key={o} value={o}>
            {o}
          </option>
        ))}
      </select>
    </label>
  );
}

function opcionesArea(gerencia: string): string[] {
  return gerencia ? Object.keys(JERARQUIA[gerencia] ?? {}) : [];
}
function opcionesProceso(gerencia: string, area: string): string[] {
  const a = area === NA ? '' : area;
  return gerencia && area ? Object.keys(JERARQUIA[gerencia]?.[a] ?? {}) : [];
}
function opcionesSub(gerencia: string, area: string, proceso: string): string[] {
  const a = area === NA ? '' : area;
  return gerencia && area ? (JERARQUIA[gerencia]?.[a]?.[proceso] ?? []) : [];
}

// ---------------------------------------------------------------------------
// Reportar
// ---------------------------------------------------------------------------

type Borrador = Omit<ReporteNuevo, 'client_id' | 'tipo_riesgo' | 'riesgo' | 'foto'> & {
  riesgoSel: string;
};

function borradorVacio(previo?: Borrador): Borrador {
  return {
    tipo: '',
    fecha: hoyLocal(),
    hora: horaLocal(),
    gerencia: previo?.gerencia ?? '',
    area: previo?.area ?? '',
    proceso: previo?.proceso ?? '',
    subproceso: previo?.subproceso ?? '',
    lugar: '',
    riesgoSel: '',
    descripcion: '',
    severidad: '',
    codigo_maquina: '',
  };
}

function FormularioReporte({
  nombre,
  enLinea,
  onGuardado,
}: {
  nombre: string;
  enLinea: boolean;
  onGuardado: () => void;
}) {
  const [b, setB] = useState<Borrador>(() => borradorVacio());
  const [foto, setFoto] = useState<string | null>(null);
  const [procesandoFoto, setProcesandoFoto] = useState(false);
  const [guardando, setGuardando] = useState(false);
  const [aviso, setAviso] = useState<{ tipo: 'ok' | 'pendiente' | 'error'; texto: string } | null>(
    null,
  );

  const set = (campo: keyof Borrador, valor: string) => setB((x) => ({ ...x, [campo]: valor }));

  const areas = opcionesArea(b.gerencia);
  const procesos = opcionesProceso(b.gerencia, b.area);
  const subs = opcionesSub(b.gerencia, b.area, b.proceso);

  // Si una gerencia no tiene áreas, «No aplica» queda elegido solo.
  useEffect(() => {
    if (b.gerencia && areas.length === 1 && areas[0] === '' && b.area !== NA) set('area', NA);
  }, [b.gerencia, b.area, areas]);

  const faltan = [
    !b.tipo && 'Tipo de reporte',
    !b.fecha && 'Fecha',
    !b.hora && 'Hora',
    !b.gerencia && 'Gerencia',
    !b.area && 'Área',
    !b.lugar.trim() && 'Lugar',
    !b.riesgoSel && 'Riesgo identificado',
    !b.descripcion.trim() && 'Descripción',
    !b.severidad && 'Potencial de severidad',
  ].filter(Boolean) as string[];

  async function elegirFoto(e: React.ChangeEvent<HTMLInputElement>) {
    const archivo = e.target.files?.[0];
    e.target.value = '';
    if (!archivo) return;
    setProcesandoFoto(true);
    try {
      setFoto(await comprimirFoto(archivo));
    } catch (err) {
      setAviso({ tipo: 'error', texto: mensaje(err) });
    } finally {
      setProcesandoFoto(false);
    }
  }

  async function enviar(e: React.FormEvent) {
    e.preventDefault();
    if (faltan.length) {
      setAviso({ tipo: 'error', texto: 'Falta completar: ' + faltan.join(', ') + '.' });
      return;
    }
    const [tipoRiesgo, riesgo] = b.riesgoSel.split('||');
    const body: ReporteNuevo = {
      client_id: nuevoClientId(),
      tipo: b.tipo,
      fecha: b.fecha,
      hora: b.hora,
      gerencia: b.gerencia,
      area: b.area === NA ? '' : b.area,
      proceso: b.proceso,
      subproceso: b.subproceso,
      lugar: b.lugar.trim(),
      tipo_riesgo: tipoRiesgo,
      riesgo,
      descripcion: b.descripcion.trim(),
      severidad: b.severidad,
      codigo_maquina: b.codigo_maquina.trim(),
      foto,
    };
    setGuardando(true);
    setAviso(null);
    try {
      // Primero al teléfono: así no se pierde aunque se corte la señal a medias.
      await guardarPendiente({ client_id: body.client_id, body, guardado: new Date().toISOString() });
      const enviados = await sincronizar();
      const mio = enviados.find((r) => r.client_id === body.client_id);
      if (mio) {
        setAviso({ tipo: 'ok', texto: `Reporte #${mio.id} enviado. ¡Gracias por reportar!` });
      } else {
        const p = (await listarPendientes()).find((x) => x.client_id === body.client_id);
        if (p?.error) setAviso({ tipo: 'error', texto: p.error });
        else
          setAviso({
            tipo: 'pendiente',
            texto: 'Sin señal: el reporte quedó guardado en este teléfono y se enviará solo al volver la conexión.',
          });
      }
      setB((x) => borradorVacio(x));
      setFoto(null);
      onGuardado();
    } catch (err) {
      setAviso({ tipo: 'error', texto: mensaje(err) });
    } finally {
      setGuardando(false);
    }
  }

  return (
    <form className="card formulario" onSubmit={enviar} noValidate>
      <h2>Nuevo reporte</h2>
      {!enLinea && (
        <p className="banda banda-offline">
          Estás sin señal. Puedes llenar el reporte: se guarda en el teléfono y se envía solo.
        </p>
      )}

      <fieldset className="campo">
        <span>
          Tipo de reporte<b className="req"> *</b>
        </span>
        <div className="segmentado">
          {TIPOS_REPORTE.map((t) => (
            <button
              type="button"
              key={t}
              className={b.tipo === t ? 'activo' : ''}
              onClick={() => set('tipo', t)}
            >
              {t}
            </button>
          ))}
        </div>
      </fieldset>

      <div className="fila">
        <label className="campo">
          <span>
            Fecha<b className="req"> *</b>
          </span>
          <input type="date" value={b.fecha} max={hoyLocal()} onChange={(e) => set('fecha', e.target.value)} />
        </label>
        <label className="campo">
          <span>
            Hora<b className="req"> *</b>
          </span>
          <input type="time" value={b.hora} onChange={(e) => set('hora', e.target.value)} />
        </label>
      </div>

      <SelectNivel
        etiqueta="Gerencia"
        requerido
        opciones={Object.keys(JERARQUIA)}
        valor={b.gerencia}
        onChange={(v) => setB((x) => ({ ...x, gerencia: v, area: '', proceso: '', subproceso: '' }))}
      />
      <SelectNivel
        etiqueta="Área"
        requerido
        opciones={areas}
        valor={b.area}
        deshabilitado={!b.gerencia}
        onChange={(v) => setB((x) => ({ ...x, area: v, proceso: '', subproceso: '' }))}
      />
      <div className="fila">
        <SelectNivel
          etiqueta="Proceso"
          opciones={procesos}
          valor={b.proceso}
          deshabilitado={!procesos.some((p) => p)}
          onChange={(v) => setB((x) => ({ ...x, proceso: v, subproceso: '' }))}
        />
        <SelectNivel
          etiqueta="Sub proceso"
          opciones={subs}
          valor={b.subproceso}
          deshabilitado={!subs.length}
          onChange={(v) => set('subproceso', v)}
        />
      </div>

      <label className="campo">
        <span>¿Quién reporta?</span>
        <input value={nombre} disabled />
      </label>

      <label className="campo">
        <span>
          Lugar<b className="req"> *</b>
        </span>
        <input
          value={b.lugar}
          maxLength={200}
          placeholder="Ej.: escalera del tacho 3, lote 12 de Finca Tarros"
          onChange={(e) => set('lugar', e.target.value)}
        />
      </label>

      <label className="campo">
        <span>
          Riesgo identificado<b className="req"> *</b>
        </span>
        <select value={b.riesgoSel} onChange={(e) => set('riesgoSel', e.target.value)}>
          <option value="">Selecciona…</option>
          {Object.entries(RIESGOS).map(([tipo, lista]) => (
            <optgroup key={tipo} label={tipo}>
              {lista.map((r) => (
                <option key={r} value={`${tipo}||${r}`}>
                  {r}
                </option>
              ))}
            </optgroup>
          ))}
        </select>
      </label>

      <label className="campo">
        <span>
          Descripción<b className="req"> *</b>
        </span>
        <textarea
          rows={4}
          maxLength={5000}
          value={b.descripcion}
          placeholder="¿Qué viste? ¿Qué podría pasar?"
          onChange={(e) => set('descripcion', e.target.value)}
        />
      </label>

      <fieldset className="campo">
        <span>
          Potencial de severidad<b className="req"> *</b>
        </span>
        <div className="segmentado">
          {SEVERIDADES.map((s) => (
            <button
              type="button"
              key={s}
              className={(b.severidad === s ? 'activo ' : '') + 'sevbtn-' + s.toLowerCase()}
              onClick={() => set('severidad', s)}
            >
              {s}
            </button>
          ))}
        </div>
      </fieldset>

      <label className="campo">
        <span>Código de la máquina involucrada (si aplica)</span>
        <input
          value={b.codigo_maquina}
          maxLength={60}
          onChange={(e) => set('codigo_maquina', e.target.value)}
        />
      </label>

      <div className="campo">
        <span>Foto</span>
        {foto ? (
          <div className="foto-previa">
            <img src={foto} alt="Foto del reporte" />
            <button type="button" className="secundario" onClick={() => setFoto(null)}>
              Quitar foto
            </button>
          </div>
        ) : (
          <label className="boton-foto">
            {procesandoFoto ? 'Procesando…' : '📷 Tomar o adjuntar foto'}
            <input type="file" accept="image/*" capture="environment" onChange={elegirFoto} hidden />
          </label>
        )}
      </div>

      {aviso && <p className={'aviso aviso-' + aviso.tipo}>{aviso.texto}</p>}

      <button type="submit" className="primario grande" disabled={guardando || procesandoFoto}>
        {guardando ? 'Enviando…' : 'Enviar reporte'}
      </button>
    </form>
  );
}

// ---------------------------------------------------------------------------
// Listas
// ---------------------------------------------------------------------------

function TarjetaReporte({ r, onAbrir }: { r: Reporte; onAbrir: (id: number) => void }) {
  return (
    <button type="button" className="tarjeta" onClick={() => onAbrir(r.id)}>
      <div className="tarjeta-cab">
        <strong>
          #{r.id} · {r.tipo}
        </strong>
        <Estado r={r} />
      </div>
      <div className="tarjeta-desc">{r.descripcion}</div>
      <div className="tarjeta-pie">
        <Severidad valor={r.severidad} />
        <span>
          {fechaCorta(r.fecha)} {r.hora}
        </span>
        <span>{r.area || r.gerencia}</span>
        <span>{r.lugar}</span>
      </div>
    </button>
  );
}

function MisReportes({
  pendientes,
  version,
  onAbrir,
  onCambio,
}: {
  pendientes: Pendiente[];
  version: number;
  onAbrir: (id: number) => void;
  onCambio: () => void;
}) {
  const [lista, setLista] = useState<Reporte[] | null>(null);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    fetchMisReportes()
      .then((x) => {
        setLista(x);
        setError(null);
      })
      .catch((e) => setError(mensaje(e)));
  }, [version]);

  return (
    <section>
      {pendientes.length > 0 && (
        <div className="card">
          <h2>Pendientes de enviar ({pendientes.length})</h2>
          <p className="hint">Están guardados en este teléfono. Se envían solos al tener señal.</p>
          {pendientes.map((p) => (
            <div key={p.client_id} className="pendiente">
              <div>
                <strong>{p.body.tipo}</strong> · {p.body.lugar}
                <div className="hint">Guardado {fechaHora(p.guardado)}</div>
                {p.error && <div className="error">No se pudo enviar: {p.error}</div>}
              </div>
              {p.error && (
                <button
                  type="button"
                  className="secundario"
                  onClick={() => descartarPendiente(p.client_id).then(onCambio)}
                >
                  Descartar
                </button>
              )}
            </div>
          ))}
        </div>
      )}

      <h2>Mis reportes</h2>
      {error && <p className="error">No se pudieron cargar: {error}</p>}
      {lista === null && !error && <p className="hint">Cargando…</p>}
      {lista?.length === 0 && (
        <p className="vacio">Todavía no has enviado reportes. Cada reporte ayuda a prevenir un accidente.</p>
      )}
      <div className="lista">
        {lista?.map((r) => (
          <TarjetaReporte key={r.id} r={r} onAbrir={onAbrir} />
        ))}
      </div>
    </section>
  );
}

const FILTROS_BANDEJA: { clave: string; etiqueta: string; f: (r: Reporte) => boolean }[] = [
  { clave: 'validar', etiqueta: 'Por validar', f: (r) => r.estado === 'Reportado' },
  { clave: 'plan', etiqueta: 'Sin plan', f: (r) => r.estado === 'Validado' },
  { clave: 'curso', etiqueta: 'En plan', f: (r) => r.estado === 'En plan de acción' },
  { clave: 'vencidos', etiqueta: 'Vencidos', f: (r) => r.vencido },
  { clave: 'cerrados', etiqueta: 'Cerrados', f: (r) => r.estado === 'Cerrado' },
  { clave: 'rechazados', etiqueta: 'Rechazados', f: (r) => r.estado === 'Rechazado' },
  { clave: 'todos', etiqueta: 'Todos', f: () => true },
];

function Bandeja({
  perfil,
  version,
  onAbrir,
}: {
  perfil: Perfil;
  version: number;
  onAbrir: (id: number) => void;
}) {
  const [lista, setLista] = useState<Reporte[] | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [filtro, setFiltro] = useState(perfil.es_seguridad ? 'validar' : 'plan');
  const [buscar, setBuscar] = useState('');

  useEffect(() => {
    fetchBandeja()
      .then((x) => {
        setLista(x);
        setError(null);
      })
      .catch((e) => setError(mensaje(e)));
  }, [version]);

  const f = FILTROS_BANDEJA.find((x) => x.clave === filtro) ?? FILTROS_BANDEJA[0];
  const texto = buscar.trim().toLowerCase();
  const visibles = (lista ?? []).filter(
    (r) =>
      f.f(r) &&
      (!texto ||
        [r.id, r.lugar, r.descripcion, r.gerencia, r.area, r.reporta_nombre, r.riesgo]
          .join(' ')
          .toLowerCase()
          .includes(texto)),
  );

  return (
    <section>
      <h2>Bandeja</h2>
      <p className="hint">
        {perfil.es_seguridad
          ? 'Como Seguridad Industrial ves los reportes de todo el ingenio.'
          : 'Ves los reportes de: ' +
            perfil.encargado_de.map((e) => e.area || e.gerencia + ' (toda)').join(', ')}
      </p>
      <div className="filtros">
        {FILTROS_BANDEJA.map((x) => {
          const n = (lista ?? []).filter(x.f).length;
          return (
            <button
              type="button"
              key={x.clave}
              className={'filtro ' + (x.clave === filtro ? 'activo' : '')}
              onClick={() => setFiltro(x.clave)}
            >
              {x.etiqueta} <b>{n}</b>
            </button>
          );
        })}
      </div>
      <input
        className="buscador"
        placeholder="Buscar por número, lugar, área, persona…"
        value={buscar}
        onChange={(e) => setBuscar(e.target.value)}
      />
      {error && <p className="error">No se pudo cargar: {error}</p>}
      {lista === null && !error && <p className="hint">Cargando…</p>}
      {lista && visibles.length === 0 && <p className="vacio">No hay reportes en «{f.etiqueta}».</p>}
      <div className="lista">
        {visibles.map((r) => (
          <TarjetaReporte key={r.id} r={r} onAbrir={onAbrir} />
        ))}
      </div>
    </section>
  );
}

